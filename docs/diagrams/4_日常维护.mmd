flowchart LR
  Q{"想改什么？"}
  Q --> Q1["条款 / 附件文字"] --> P1["条款维护 → 修改"]
  Q --> Q2["条款顺序、增删条款<br/>附件顺序、默认有无"] --> P2["条款维护 → 结构"]
  Q --> Q3["变量默认值<br/>把文字改成变量"] --> P3["条款维护 → 变量 / 改成变量"]
  Q --> Q4["买方 / 项目质保期"] --> P4["预存信息管理"]
  Q --> Q5["多种写法（选项库）<br/>付款条款、版式"] --> W5["改文件或交给 AI<br/>options/、payment_terms.yaml、templates/"]
  P1 & P2 & P3 --> R["自动备份 → 试生成 → 修订记录 → 更新快照"]
  P4 --> R2["保存即生效，自动备份"]
