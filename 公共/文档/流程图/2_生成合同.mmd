flowchart TD
  S["启动表单.bat"] --> T["选合同类型 FA / PO<br/>或打开已保存的合同"]
  T --> F1["① 必填信息<br/>编号、标的物、买卖方、含税总价"]
  F1 --> F2["② 条款写法<br/>付款方案、质保方式、争议解决等"]
  F2 --> F3["③ 默认条款参数<br/>违约金比例、付款天数等"]
  F3 --> G["点“生成合同”"]
  G --> C1["保存配置到 合同配置/"]
  G --> A0["组装器读配方"]
  A0 --> A1["逐项取块 / 目录 / 原子"]
  A1 --> A2["变量取值：默认值 → 预存库 → 表单值"]
  A2 --> A3["计算：不含税价、税额、中英文大写<br/>质保期按项目编号选用"]
  A3 --> A4["选项与付款：按所选写法取文字<br/>未选节点不出现"]
  A4 --> A5["不适用条款：保留并标注"]
  A5 --> A6["自动编号、交叉引用、目录"]
  A6 --> O["输出/ Word 合同 + 生成报告<br/>未填处黄色【待填】"]
